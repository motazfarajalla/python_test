pipeline {
    agent any
    //agent { 
    //    node {
    //        label 'agent-alpine-1'
    //        }
    //  }
    triggers {
        pollSCM '* * * * *'
    }
    stages {
        stage('Build') {
            steps {
                echo "Building.."
                sh '''
                su - root -c apt-get update
                su - root -c apt-get install -y python3 python3-pip
                python3 --version
                pip3 --version
                cd testapp
                pip install -r requirement.txt
                '''
            }
        }
        stage('Test') {
            steps {
                echo "Testing.."
                sh '''
                cd testapp
                python3 hello.py
                python3 hello.py --name=Brad
                '''
            }
        }
        stage('Deliver') {
            steps {
                echo 'Deliver....'
                sh '''
                echo "doing delivery stuff.."
                '''
            }
        }
    }
}