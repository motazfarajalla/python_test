pipeline {
    agent any
    //agent { 
    //    node {
    //        label 'agent-alpine-1'
    //        }
    //  }
    triggers {
        pollSCM '* * * * *'
    }
    stages {
        stage('Build') {
            steps {
                echo "Building.."
                sh '''
                cd testapp
                # Create virtual environment
                python3 -m venv venv
                # Activate and install dependencies
                . venv/bin/activate
                pip install -r requirement.txt
                '''
            }
        }
        stage('Test') {
            steps {
                echo "Testing.."
                sh '''
                cd testapp
                . venv/bin/activate
                python3 hello.py
                python3 hello.py --name=Brad
                '''
            }
        }
        stage('Deliver') {
            steps {
                echo 'Deliver....'
                sh '''
                echo "doing delivery stuff.."
                '''
            }
        }
    }
}